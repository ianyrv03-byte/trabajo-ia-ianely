# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
LLM_PROVIDER=anthropic          # anthropic | openai | none (sin IA: solo respuestas directas)
MODEL_NAME=claude-haiku-5-5     # verifica el identificador vigente con tu proveedor
LLM_API_KEY=
ADMIN_TOKEN=                    # texto largo y aleatorio (mínimo 16 caracteres)
ID_SALT=                        # texto aleatorio para anonimizar identificadores
TIMEZONE=America/Hermosillo
SHOW_ADMIN_LINK=true
# Opcional: publicar el catálogo desde /admin
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
# Opcional: recibir los informes de «sin respuesta»
REPORT_WEBHOOK_URL=
